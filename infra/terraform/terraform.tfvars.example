aws_region       = "ap-northeast-1"
project_name     = "kakao-maple-bot"
lambda_zip_path  = "../../apps/lambda/dist/lambda.zip"
bot_enabled      = false
allowed_rooms    = ""
admin_senders    = ""
stock_enabled    = false
notice_alert_enabled  = false
notice_alert_keywords = "채널 점검,마이너버전,클라이언트"

# Keep secrets out of Git. Supply them through an ignored terraform.tfvars,
# environment-driven tfvars, or a CI secret manager.
bot_shared_secret = ""
nexon_api_key     = ""
krx_auth_key      = ""
tiingo_token      = ""
tmdb_read_access_token = ""
tmdb_region            = "KR"
